# Copy to .env and fill with your keys. NEVER commit .env or real secrets.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- MongoDB (optional) ---
MONGODB_URI=
# Legacy alias (avoid in new setups):
# VITE_MONGODB_URI=

# --- AI providers (server-side only; use non-VITE names) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
# Anthropic alias (either CLAUDE_API_KEY or ANTHROPIC_API_KEY):
ANTHROPIC_API_KEY=

# --- Spotify OAuth (optional) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/auth/spotify/callback

# --- YouTube / Google OAuth (optional) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5173/auth/youtube/callback

# --- Instagram (optional) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Client-only (never put API secrets here in production) ---
VITE_ENCRYPTION_KEY=your_32_character_encryption_key_here
VITE_JWT_SECRET=your_jwt_secret_key_here
